[
 {
  "start": 0,
  "end": 4.332,
  "text": "Six things you should never do as a British person playing GTA 6."
 },
 {
  "start": 4.452,
  "end": 5.273,
  "text": "Number 4"
 },
 {
  "start": 5.393,
  "end": 6.714,
  "text": "will get you deported."
 },
 {
  "start": 7.014,
  "end": 7.514,
  "text": "1"
 },
 {
  "start": 7.694,
  "end": 9.134,
  "text": "Don't queue at the gun shop."
 },
 {
  "start": 9.254,
  "end": 10.872,
  "text": "\"Bruv, nobody's queuing"
 },
 {
  "start": 10.992,
  "end": 14.168,
  "text": "That man behind you has a rocket launcher and zero patience."
 },
 {
  "start": 14.288,
  "end": 14.771,
  "text": "Two"
 },
 {
  "start": 14.891,
  "end": 17.327,
  "text": "Don't apologize after you hit someone with the car."
 },
 {
  "start": 17.447,
  "end": 19.855,
  "text": "You're already doing a hundred down Ocean Drive."
 },
 {
  "start": 20.105,
  "end": 22.356,
  "text": "Sorry mate isn't fixing his spine."
 },
 {
  "start": 22.476,
  "end": 23.003,
  "text": "3"
 },
 {
  "start": 23.123,
  "end": 24.789,
  "text": "Don't stop at the zebra crossing."
 },
 {
  "start": 24.909,
  "end": 26.352,
  "text": "There's no zebra crossing."
 },
 {
  "start": 26.602,
  "end": 29.624,
  "text": "There's a crocodile on the road and a man in a thong filming it."
 },
 {
  "start": 29.744,
  "end": 30.307,
  "text": "4"
 },
 {
  "start": 30.527,
  "end": 32.642,
  "text": "Don't ask for a cup of tea in Vice City."
 },
 {
  "start": 32.842,
  "end": 35.31,
  "text": "They'll hand you an iced coffee the size of your nan."
 },
 {
  "start": 35.56,
  "end": 36.625,
  "text": "You will cry."
 },
 {
  "start": 36.745,
  "end": 40.668,
  "text": "And yeah, I know you've already planned your first heist around the Greg's opening hours."
 },
 {
  "start": 40.968,
  "end": 42.175,
  "text": "Doesn't exist over there."
 },
 {
  "start": 42.295,
  "end": 43.356,
  "text": "Grieve properly."
 },
 {
  "start": 43.476,
  "end": 44.05,
  "text": "5"
 },
 {
  "start": 44.17,
  "end": 45.627,
  "text": "Don't complain about the weather."
 },
 {
  "start": 45.747,
  "end": 47.697,
  "text": "It's 32 degrees and sunny."
 },
 {
  "start": 47.817,
  "end": 50.31,
  "text": "You've been moaning about rain since 2013."
 },
 {
  "start": 50.56,
  "end": 51.411,
  "text": "Enjoy it."
 },
 {
  "start": 51.611,
  "end": 51.948,
  "text": "Now."
 },
 {
  "start": 52.198,
  "end": 53.258,
  "text": "Let's talk money."
 },
 {
  "start": 53.378,
  "end": 54.005,
  "text": "6"
 },
 {
  "start": 54.125,
  "end": 56.115,
  "text": "Don't convert the prices into pounds."
 },
 {
  "start": 56.235,
  "end": 59.625,
  "text": "A Vice City mansion costs more than your whole street in Croydon."
 },
 {
  "start": 59.745,
  "end": 61.789,
  "text": "Just rob a bank like a normal person."
 },
 {
  "start": 61.909,
  "end": 62.317,
  "text": "So"
 },
 {
  "start": 62.567,
  "end": 64.035,
  "text": "Which one are you breaking first?"
 },
 {
  "start": 64.235,
  "end": 64.868,
  "text": "Be honest."
 },
 {
  "start": 65.048,
  "end": 65.705,
  "text": "Comments."
 },
 {
  "start": 65.825,
  "end": 67.365,
  "text": "Follow Vice City Sin"
 },
 {
  "start": 67.485,
  "end": 69.173,
  "text": "Every sin's a story."
 }
]