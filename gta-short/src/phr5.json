[
 {
  "start": 0,
  "end": 3.874,
  "text": "A baby born the day GTA 5 came out is now 13."
 },
 {
  "start": 4.074,
  "end": 6.697,
  "text": "and still not old enough to buy GTA 6."
 },
 {
  "start": 6.897,
  "end": 8.356,
  "text": "13 years"
 },
 {
  "start": 8.556,
  "end": 10.08,
  "text": "Rockstar Games made us wait."
 },
 {
  "start": 10.28,
  "end": 11.58,
  "text": "13 years."
 },
 {
  "start": 11.78,
  "end": 15.236,
  "text": "Some of you got married, divorced, and remarried in that time."
 },
 {
  "start": 15.616,
  "end": 16.375,
  "text": "same woman"
 },
 {
  "start": 16.695,
  "end": 17.367,
  "text": "twice"
 },
 {
  "start": 17.567,
  "end": 22.582,
  "text": "GTA 5 has sold over 220 million copies, according to Take 2."
 },
 {
  "start": 22.782,
  "end": 24.873,
  "text": "220 million"
 },
 {
  "start": 25.073,
  "end": 26.461,
  "text": "And Rockstar still said"
 },
 {
  "start": 26.661,
  "end": 28.101,
  "text": "Nah, we'll take our time."
 },
 {
  "start": 28.301,
  "end": 31.408,
  "text": "And don't act like you didn't refresh the release date every week."
 },
 {
  "start": 31.708,
  "end": 32.489,
  "text": "I saw you."
 },
 {
  "start": 32.769,
  "end": 33.988,
  "text": "Everyone saw you."
 },
 {
  "start": 34.288,
  "end": 34.69,
  "text": "Now"
 },
 {
  "start": 34.89,
  "end": 35.85,
  "text": "Let's talk money."
 },
 {
  "start": 36.05,
  "end": 41.357,
  "text": "The first GTA 6 trailer pulled 93 million views on YouTube in 24 hours."
 },
 {
  "start": 41.557,
  "end": 44.263,
  "text": "That's more than the entire population of the UK."
 },
 {
  "start": 44.463,
  "end": 46.326,
  "text": "watching 90 seconds of a game."
 },
 {
  "start": 46.526,
  "end": 47.511,
  "text": "in one day."
 },
 {
  "start": 47.831,
  "end": 48.487,
  "text": "So tell me"
 },
 {
  "start": 48.787,
  "end": 50.966,
  "text": "What were you doing when GTA 5 came out?"
 },
 {
  "start": 51.166,
  "end": 52.413,
  "text": "Because I promise you?"
 },
 {
  "start": 52.613,
  "end": 53.699,
  "text": "It wasn't this."
 },
 {
  "start": 53.899,
  "end": 55.401,
  "text": "Follow Vice City Sin."
 },
 {
  "start": 55.601,
  "end": 57.021,
  "text": "Every sin's a story."
 }
]