[
 {
  "i": 0,
  "start": 0.0,
  "end": 3.278,
  "text": "Strip clubs in GTA 6 are copied off a real Miami club."
 },
 {
  "i": 1,
  "start": 3.37,
  "end": 6.062,
  "text": "And one of the customers looks exactly like Kodak Black."
 },
 {
  "i": 2,
  "start": 6.154,
  "end": 7.073,
  "text": "GTA 6"
 },
 {
  "i": 3,
  "start": 7.166,
  "end": 9.077,
  "text": "November 19th, 2026."
 },
 {
  "i": 4,
  "start": 9.17,
  "end": 10.317,
  "text": "5 days lads."
 },
 {
  "i": 5,
  "start": 10.41,
  "end": 11.771,
  "text": "Every man who's told his girl."
 },
 {
  "i": 6,
  "start": 11.864,
  "end": 13.753,
  "text": "Babe, I'm only playing it for the story."
 },
 {
  "i": 7,
  "start": 14.049,
  "end": 14.686,
  "text": "Bad news."
 },
 {
  "i": 8,
  "start": 14.778,
  "end": 15.736,
  "text": "The club's in the story"
 },
 {
  "i": 9,
  "start": 15.829,
  "end": 19.066,
  "text": "Its owner, Booby Ike, uses the club money to fund his record label."
 },
 {
  "i": 10,
  "start": 19.159,
  "end": 20.552,
  "text": "It's called the Jack of Hearts."
 },
 {
  "i": 11,
  "start": 20.645,
  "end": 21.913,
  "text": "Miami's most famous club?"
 },
 {
  "i": 12,
  "start": 22.006,
  "end": 22.871,
  "text": "King of Diamonds"
 },
 {
  "i": 13,
  "start": 22.963,
  "end": 24.092,
  "text": "Very subtle, Rockstar."
 },
 {
  "i": 14,
  "start": 24.184,
  "end": 27.979,
  "text": "Trailer 2 hit 475 million views in 24 hours."
 },
 {
  "i": 15,
  "start": 28.072,
  "end": 29.665,
  "text": "That's more than Deadpool and Wolverine."
 },
 {
  "i": 16,
  "start": 29.758,
  "end": 31.128,
  "text": "Marvel lost to Vice City."
 },
 {
  "i": 17,
  "start": 31.221,
  "end": 33.174,
  "text": "I've watched the club bit frame by frame."
 },
 {
  "i": 18,
  "start": 33.377,
  "end": 33.733,
  "text": "*c"
 },
 {
  "i": 19,
  "start": 33.918,
  "end": 34.575,
  "text": "for journalism."
 },
 {
  "i": 20,
  "start": 34.807,
  "end": 36.103,
  "text": "Here's what's actually confirmed."
 },
 {
  "i": 21,
  "start": 36.195,
  "end": 40.567,
  "text": "Jason walks past an ID check sign, a throw button pops up, and he makes it rain."
 },
 {
  "i": 22,
  "start": 40.66,
  "end": 41.496,
  "text": "Private dances?"
 },
 {
  "i": 23,
  "start": 41.588,
  "end": 42.252,
  "text": "Not shown yet."
 },
 {
  "i": 24,
  "start": 42.345,
  "end": 46.456,
  "text": "In GTA V they were $40 and the bouncer kicked you out after 3 strikes."
 },
 {
  "i": 25,
  "start": 46.549,
  "end": 47.69,
  "text": "Now, let's talk money."
 },
 {
  "i": 26,
  "start": 47.783,
  "end": 51.341,
  "text": "GTA 5 has sold nearly 235 million copies."
 },
 {
  "i": 27,
  "start": 51.434,
  "end": 54.084,
  "text": "That's more than three copies for every person in the UK."
 },
 {
  "i": 28,
  "start": 54.176,
  "end": 54.73,
  "text": "3 of you"
 },
 {
  "i": 29,
  "start": 54.823,
  "end": 56.75,
  "text": "Same balancer, same three strikes."
 },
 {
  "i": 30,
  "start": 56.843,
  "end": 57.814,
  "text": "Oh, and Kodak?"
 },
 {
  "i": 31,
  "start": 57.907,
  "end": 61.761,
  "text": "The screenshot shows his haircut and face tattoos, and he's holding a jack of hearts cup."
 },
 {
  "i": 32,
  "start": 61.854,
  "end": 62.78,
  "text": "Nobody said it's him."
 },
 {
  "i": 33,
  "start": 62.872,
  "end": 63.464,
  "text": "You decide."
 },
 {
  "i": 34,
  "start": 63.557,
  "end": 64.328,
  "text": "So be honest."
 },
 {
  "i": 35,
  "start": 64.42,
  "end": 66.254,
  "text": "On day one, is it story first?"
 },
 {
  "i": 36,
  "start": 66.346,
  "end": 67.703,
  "text": "or straight to the jack of hearts."
 },
 {
  "i": 37,
  "start": 67.795,
  "end": 71.806,
  "text": "Tell me in the comments and follow Vice City Sin for everything GTA 6."
 }
]